# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chatdcc

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# VTI SSO
VTI_JWT_SECRET=your-vti-jwt-secret
