# AI Provider (OpenAI-compatible, e.g. Ollama)
AI_PROVIDER_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL_NAME=qwen3.5:9b

# A-Track
ATRACK_URL=http://127.0.0.1:3000

# Room Reservation API (SAR)
ROOMS_API_URL=https://apps.dcc.uchile.cl/sistema_administracion_recursos
SAR_API_KEY=bot_your-api-key-here

# DCC Services API
DCC_SERVICES_API_URL=http://127.0.0.1:3000
